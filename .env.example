# Copy to .env (or run sh init.sh, which generates the secrets) and fill in the values.
PORT=8090
BIND_ADDRESS=0.0.0.0
COOKIE_SECURE=0
POSTGRES_PASSWORD=
SSO_INTERNAL_KEY=
DEMO_PASSWORD=
# Gemini API: mesačný sprievodca Knihy jázd a doplnenie dňa v Denníku (Workplan)
GEMINI_API_KEY=
# Optional; default is the cheapest stable multimodal model.
GEMINI_MODEL=gemini-3.6-flash
# Portál · verejná adresa do pozývacích odkazov (napr. https://kbm.<tailnet>.ts.net); prázdne = adresa z prehliadača
PUBLIC_URL=
# Portál · odosielanie pozvánok e-mailom (voliteľné). Gmail: smtp.gmail.com, port 587, heslo aplikácie.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
