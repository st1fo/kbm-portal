# Copy to .env (or run sh init.sh, which generates the secrets) and fill in the values.
PORT=8090
BIND_ADDRESS=0.0.0.0
COOKIE_SECURE=0
POSTGRES_PASSWORD=
SSO_INTERNAL_KEY=
DEMO_PASSWORD=
# Kniha jázd · mesačný sprievodca (Gemini API, used only by the logbook backend)
GEMINI_API_KEY=
# Optional; default is the cheapest stable multimodal model.
GEMINI_MODEL=gemini-3.1-flash-lite
